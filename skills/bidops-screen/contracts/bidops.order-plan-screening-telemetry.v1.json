{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidops.internal/schemas/bidops.order-plan-screening-telemetry.v1.json",
  "title": "BidOps order-plan screening telemetry v1",
  "x-bidops-producer": "order-plan-screening-worker",
  "x-bidops-consumer": "observability-and-merge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "consumer", "execution_id", "source_run_id", "status", "execution", "batches", "created_at"],
  "properties": {
    "schema_version": {"const": "bidops.order-plan-screening-telemetry.v1"},
    "producer": {"const": "order-plan-screening-worker"},
    "consumer": {"const": "observability-and-merge"},
    "execution_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "not_measured"]},
    "execution": {"$ref": "#/$defs/measurement"},
    "batches": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["batch_id", "sequence", "status", "attempts"], "properties": {"batch_id": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1}, "status": {"enum": ["success", "failed", "rejected", "unknown"]}, "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}}}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "measurement": {"type": "object", "additionalProperties": false, "required": ["started_at", "finished_at", "duration_ms", "input_tokens", "cached_input_tokens", "output_tokens", "total_tokens"], "properties": {"started_at": {"type": ["string", "null"], "format": "date-time"}, "finished_at": {"type": ["string", "null"], "format": "date-time"}, "duration_ms": {"type": ["integer", "null"], "minimum": 0}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "total_tokens": {"type": ["integer", "null"], "minimum": 0}}},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["attempt_no", "status", "started_at", "finished_at", "measurement"], "properties": {"attempt_no": {"type": "integer", "minimum": 1}, "status": {"enum": ["success", "failed", "rejected"]}, "started_at": {"type": ["string", "null"], "format": "date-time"}, "finished_at": {"type": ["string", "null"], "format": "date-time"}, "measurement": {"$ref": "#/$defs/measurement"}}}
  }
}
