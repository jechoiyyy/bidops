{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidops.internal/schemas/bidops.order-plan-screening-decisions.v1.json",
  "title": "BidOps order-plan Qwen decisions v1",
  "x-bidops-producer": "order-plan-screening-qwen-worker",
  "x-bidops-consumer": "order-plan-screening-merge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "consumer", "execution_id", "source_run_id", "input_artifact_sha256", "ranking_artifact_sha256", "binding", "status", "candidate_count", "success_count", "failure_count", "batch_count", "batches", "items", "created_at"],
  "properties": {
    "schema_version": {"const": "bidops.order-plan-screening-decisions.v1"},
    "producer": {"const": "order-plan-screening-qwen-worker"},
    "consumer": {"const": "order-plan-screening-merge"},
    "execution_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "input_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "ranking_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "binding": {"$ref": "#/$defs/binding"},
    "status": {"enum": ["성공", "부분 성공", "실패"]},
    "candidate_count": {"type": "integer", "minimum": 0},
    "success_count": {"type": "integer", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "batch_count": {"type": "integer", "minimum": 0},
    "batches": {"type": "array", "items": {"$ref": "#/$defs/batch"}},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["model_name", "model_digest", "prompt_version", "prompt_sha256", "company_profile_version", "company_profile_sha256", "generation_config_sha256"], "properties": {"model_name": {"const": "qwen3.8-27B"}, "model_digest": {"$ref": "#/$defs/sha256"}, "prompt_version": {"type": "string", "minLength": 1}, "prompt_sha256": {"$ref": "#/$defs/sha256"}, "company_profile_version": {"type": "string", "minLength": 1}, "company_profile_sha256": {"$ref": "#/$defs/sha256"}, "generation_config_sha256": {"$ref": "#/$defs/sha256"}}},
    "batch": {"type": "object", "additionalProperties": false, "required": ["batch_id", "sequence", "plan_ids", "attempt_count", "status"], "properties": {"batch_id": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1}, "plan_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "attempt_count": {"type": "integer", "minimum": 1}, "status": {"enum": ["success", "failed", "rejected"]}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["plan_id", "batch_id", "attempt_no", "relevance", "score", "reason"], "properties": {"plan_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}, "attempt_no": {"type": "integer", "minimum": 1}, "relevance": {"enum": ["relevant", "not_relevant", "uncertain"]}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}}}
  }
}
