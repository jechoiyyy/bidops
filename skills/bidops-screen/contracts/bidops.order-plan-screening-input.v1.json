{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidops.internal/schemas/bidops.order-plan-screening-input.v1.json",
  "title": "BidOps order-plan screening frozen input v1",
  "x-bidops-producer": "order-plan-screening-orchestrator",
  "x-bidops-consumer": "order-plan-screening-worker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "consumer", "execution_id", "source_run_id", "source_artifact", "population_count", "population_sha256", "policy", "stage1_binding", "stage2_binding", "items", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "bidops.order-plan-screening-input.v1"},
    "producer": {"const": "order-plan-screening-orchestrator"},
    "consumer": {"const": "order-plan-screening-worker"},
    "execution_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_artifact": {"$ref": "#/$defs/artifact"},
    "population_count": {"type": "integer", "minimum": 1},
    "population_sha256": {"$ref": "#/$defs/sha256"},
    "policy": {"$ref": "#/$defs/binding"},
    "stage1_binding": {"$ref": "#/$defs/binding"},
    "stage2_binding": {"$ref": "#/$defs/binding"},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["plan_id", "title"], "properties": {"plan_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}}}},
    "status": {"const": "frozen"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["name", "schema_version", "sha256"], "properties": {"name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\].*"}, "schema_version": {"const": "bidops.collected-order-plans.v1"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["version", "sha256"], "properties": {"version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
