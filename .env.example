# External secret-manager placeholders only. Do not commit real credentials.
BIDOPS_OWNER_PASSWORD=replace-in-secret-manager
BIDOPS_MIGRATE_PASSWORD=replace-in-secret-manager
BIDOPS_APP_PASSWORD=replace-in-secret-manager
BIDOPS_WORKER_PASSWORD=replace-in-secret-manager
BIDOPS_RO_BACKUP_PASSWORD=replace-in-secret-manager
BIDOPS_MINIO_ROOT_USER=replace-in-secret-manager
BIDOPS_MINIO_ROOT_PASSWORD=replace-in-secret-manager
BIDOPS_SOURCE_ACCESS_KEY=replace-in-secret-manager
BIDOPS_SOURCE_SECRET_KEY=replace-in-secret-manager
BIDOPS_STRUCTURE_ACCESS_KEY=replace-in-secret-manager
BIDOPS_STRUCTURE_SECRET_KEY=replace-in-secret-manager
BIDOPS_STRUCTURE_READ_ACCESS_KEY=replace-in-secret-manager
BIDOPS_STRUCTURE_READ_SECRET_KEY=replace-in-secret-manager
BIDOPS_QUARANTINE_ACCESS_KEY=replace-in-secret-manager
BIDOPS_QUARANTINE_SECRET_KEY=replace-in-secret-manager
BIDOPS_MODEL_RESPONSE_ACCESS_KEY=replace-in-secret-manager
BIDOPS_MODEL_RESPONSE_SECRET_KEY=replace-in-secret-manager
BIDOPS_MODEL_RESPONSE_ENCRYPTION_KEY=replace-in-secret-manager
BIDOPS_MODEL_RESPONSE_ENCRYPTION_KEY_REF=replace-in-secret-manager
# Fill these immutable references only after candidate quality evidence passes.
BIDOPS_ACTIVE_PROFILE_VERSION_ID=
BIDOPS_ACTIVE_ANALYSIS_POLICY_VERSION_ID=
# Remote OpenAI-compatible vLLM endpoint. Keep credentials out of the URL and
# allow exactly the same literal IP. EMPTY is valid only for a server that has
# authentication disabled. 192.0.2.10 is a TEST-NET placeholder, not a
# usable model server.
BIDOPS_VLLM_BASE_URL=http://192.0.2.10:8000/v1
BIDOPS_VLLM_ALLOWED_HOSTS=192.0.2.10
BIDOPS_VLLM_MODEL=qwen3.8-27B
BIDOPS_VLLM_API_KEY=replace-in-secret-manager-or-EMPTY
# Provider switch. Production stays on vllm. codex-exec is an external,
# development-only reference path and fails closed unless all gates are set
# and the internal numeric notice ID is explicitly allowlisted.
# vllm (production target), codex-exec (approved reference only), or mock
# (workflow tests only; requires BIDOPS_REFERENCE_WORKFLOW_MODE=true).
BIDOPS_ANALYSIS_PROVIDER=vllm
BIDOPS_OPENAI_ENABLED=false
BIDOPS_CODEX_EXEC_ENABLED=false
BIDOPS_CODEX_EXEC_BIN=codex
BIDOPS_CODEX_EXEC_MODEL=gpt-5.6-sol
BIDOPS_CODEX_EXEC_REASONING_EFFORT=low
BIDOPS_CODEX_EXEC_APPROVED_NOTICE_IDS=
BIDOPS_REFERENCE_WORKFLOW_MODE=false
BIDOPS_OBJECT_STORE_BACKEND=minio
BIDOPS_OBJECT_STORE_ENDPOINT=minio:9000
BIDOPS_OBJECT_STORE_SECURE=false
BIDOPS_POSTGRES_PORT=15432
BIDOPS_WEB_PORT=18787
BIDOPS_MINIO_PORT=19000
BIDOPS_MINIO_CONSOLE_PORT=19001
BIDOPS_CLAMAV_HOST=clamav
BIDOPS_CLAMAV_PORT=3310
BIDOPS_CLAMAV_TIMEOUT_SECONDS=15
