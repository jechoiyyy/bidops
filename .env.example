# Copy this file to .env. Values here are safe placeholders; never commit .env.
#
# 공통 환경 파일. 모든 compose 파일이 이 파일 하나를 top-level env로 사용한다.
#   - docker-compose.yml   (애플리케이션 스택)
#   - docker-compose.edge.yml            -> 전용 값 없음(아래 WEB_BIND_HOST/WEB_PORT를 읽는다)
# overlay 전용 값은 여기 두지 않는다. `env/<overlay>.env`를 추가 --env-file로 넘긴다.
#   - docker-compose.model-egress.yml    -> env/model.env
#   - docker-compose.c2-order-plan.yml   -> env/model.env (C-2 입력 경로 절)
#   - docker-compose.prespec-attachment.yml -> env/prespec-attachment.env
#   - docker-compose.mock-reference.yml  -> 전용 값 없음(파일 안에 리터럴로 선언)
#
# --- 프로세스 정체성과 고정 경로 ---
BIDOPS_UID=1000
BIDOPS_GID=1000
# BIDOPS_ROOT/BIDOPS_DATA_DIR/BIDOPS_ATTACHMENTS_DIR은 여기 두지 않는다.
# 컨테이너 경로는 docker-compose.yml이 BIDOPS_ROOT=/app으로 선언하고
# 나머지 둘은 config.py가 root에서 유도한다(config.py:240-243).
# 공통 .env에 컨테이너 경로를 두면 host에서 pytest가 /app을 만들려다 실패한다.

# --- 담당자와 로그 ---
BIDOPS_REVIEWER=
BIDOPS_LOG_LEVEL=WARNING
BIDOPS_LOG_TRACEBACK=false

# --- 나라장터 수집 ---
# BIDOPS_G2B_API_KEY=
# 사전규격 첨부 취득은 기본 비활성이다. host 방화벽에서 승인한 뒤에만 켠다.
BIDOPS_G2B_ATTACHMENT_ENABLED=false
BIDOPS_G2B_ATTACHMENT_ALLOWED_HOSTS=
BIDOPS_G2B_ATTACHMENT_TIMEOUT_SECONDS=30

# --- 스케줄러와 사전규격(기본 비활성) ---
BIDOPS_SCHEDULER_ENABLED=false
BIDOPS_SCHEDULE_DAILY_TIME=02:00
BIDOPS_SCHEDULE_WEEKLY_TIME=06:00
BIDOPS_PRESPEC_ENABLED=false

# --- 모델 endpoint(용도 공유값) ---
# 모든 용도가 이 값을 기본으로 쓰고, 용도별 override가 있으면 그것을 쓴다.
# 허용 host를 비우면 host 제한이 없다(MVP 기간 완화, ADR-0050). 값을 적으면 그
# 목록의 host로만 나간다. hosted 주소는 넣지 않는다.
BIDOPS_VLLM_BASE_URL=http://127.0.0.1:8000/v1
BIDOPS_VLLM_ALLOWED_HOSTS=
BIDOPS_VLLM_API_KEY=EMPTY
# 배포가 증언하는 64자 model revision(ADR-0042). 비우면 제한 없이 통과하고
# (MVP 기간 완화, ADR-0050), 값을 적으면 64자 hex여야 하며 서버가 내는 값과
# 대조한다.
BIDOPS_VLLM_MODEL_REVISION=

# --- 용도별 override 예시(비면 위의 공유값을 쓴다) ---
# 용도는 screening(C-1 공고 판정), overview(사전규격 개요), deep_review다.
# BIDOPS_VLLM_SCREENING_BASE_URL=
# BIDOPS_VLLM_SCREENING_ALLOWED_HOSTS=
# BIDOPS_VLLM_SCREENING_API_KEY=
# BIDOPS_VLLM_SCREENING_MODEL_REVISION=
# BIDOPS_VLLM_OVERVIEW_BASE_URL=
# BIDOPS_VLLM_OVERVIEW_ALLOWED_HOSTS=
# BIDOPS_VLLM_OVERVIEW_API_KEY=
# BIDOPS_VLLM_OVERVIEW_MODEL_REVISION=
# API dialect: vllm | ollama | litellm. LiteLLM still uses the purpose-specific
# base URL/key above; no gateway URL or key is taken from an implicit fallback.
# BIDOPS_VLLM_OVERVIEW_API_DIALECT=vllm
# BIDOPS_VLLM_SCREENING_API_DIALECT=vllm
# BIDOPS_VLLM_DEEP_REVIEW_API_DIALECT=vllm
# BIDOPS_PRESPEC_OVERVIEW_POLICY_PATH=
# BIDOPS_VLLM_DEEP_REVIEW_BASE_URL=
# BIDOPS_VLLM_DEEP_REVIEW_ALLOWED_HOSTS=
# BIDOPS_VLLM_DEEP_REVIEW_API_KEY=
# BIDOPS_VLLM_DEEP_REVIEW_MODEL_REVISION=

# --- 판정 파이프라인 튜닝(C-1 endpoint는 env/model.env에 있다) ---
# C-1이 부르는 모델명. server의 `GET /models` id와 같아야 한다. 개요·심층
# 검토는 policy의 `model_name`을 쓰므로 설정 항목이 없다.
BIDOPS_VLLM_SCREENING_MODEL=qwen3.8-27B
# 판정 생성 예산. stage별 출력 상한은 호출에서 `max_tokens`가 되고 context
# 크기는 대응 파라미터가 없어 binding 기록에만 남는다.
BIDOPS_SCREENING_CONTEXT_SIZE=16384
BIDOPS_SCREENING_MAX_OUTPUT_TOKENS=2048
BIDOPS_SCREENING_SYNTHESIS_MAX_OUTPUT_TOKENS=4096
# vllm | mock. mock은 참조 흐름 전용이며 BIDOPS_REFERENCE_WORKFLOW_MODE=true를
# 함께 켜야 한다. 운영 판정 결과나 품질 승인으로 쓰지 않는다.
BIDOPS_SCREENING_PROVIDER=vllm
# 참조 흐름 mode. 기본은 비활성이다. true이면 (1) 결정적 mock provider가 허용되고
# (2) 심층 검토가 policy의 model_name 대조를 건너뛴다(model_endpoint_ref 검사는
# 유지). 그 실행의 결과에는 quality_status=unmeasured_reference 또는
# mock_reference 표식이 붙으며 **운영 완료·품질 근거·정책 활성화 근거가 아니다.**
# 절차는 docs/operations.md의 "사전규격 심층 검토 참조 실행"이다.
BIDOPS_REFERENCE_WORKFLOW_MODE=false
BIDOPS_SCREEN_MAX_CONCURRENCY=1
BIDOPS_SCREEN_HEARTBEAT_SECONDS=5
BIDOPS_SCREEN_STALE_AFTER_SECONDS=60

# --- PostgreSQL 역할 비밀번호(서로 달라야 한다) ---
BIDOPS_OWNER_PASSWORD=replace-in-secret-manager
BIDOPS_MIGRATE_PASSWORD=replace-in-secret-manager
BIDOPS_APP_PASSWORD=replace-in-secret-manager
BIDOPS_WORKER_PASSWORD=replace-in-secret-manager
BIDOPS_RO_BACKUP_PASSWORD=replace-in-secret-manager

# --- MinIO root와 용도별 자격증명 ---
BIDOPS_MINIO_ROOT_USER=replace-in-secret-manager
BIDOPS_MINIO_ROOT_PASSWORD=replace-in-secret-manager
BIDOPS_SOURCE_ACCESS_KEY=replace-in-secret-manager
BIDOPS_SOURCE_SECRET_KEY=replace-in-secret-manager
BIDOPS_STRUCTURE_ACCESS_KEY=replace-in-secret-manager
BIDOPS_STRUCTURE_SECRET_KEY=replace-in-secret-manager
BIDOPS_STRUCTURE_READ_ACCESS_KEY=replace-in-secret-manager
BIDOPS_STRUCTURE_READ_SECRET_KEY=replace-in-secret-manager
BIDOPS_QUARANTINE_ACCESS_KEY=replace-in-secret-manager
BIDOPS_QUARANTINE_SECRET_KEY=replace-in-secret-manager
BIDOPS_MODEL_RESPONSE_ACCESS_KEY=replace-in-secret-manager
BIDOPS_MODEL_RESPONSE_SECRET_KEY=replace-in-secret-manager
BIDOPS_PROPOSAL_PDF_ACCESS_KEY=replace-in-secret-manager
BIDOPS_PROPOSAL_PDF_SECRET_KEY=replace-in-secret-manager

# --- 모델 응답 암호화(AES-GCM, base64url 또는 hex로 16/24/32 byte) ---
BIDOPS_MODEL_RESPONSE_ENCRYPTION_KEY=replace-in-secret-manager
BIDOPS_MODEL_RESPONSE_ENCRYPTION_KEY_REF=replace-in-secret-manager

# --- 객체 저장소와 악성코드 검사 ---
# BIDOPS_OBJECT_STORE_*와 BIDOPS_CLAMAV_*는 여기 두지 않는다.
# docker-compose.yml의 `x-object-store-env`·`x-clamav-env` 블록이 이미 선언한다.
# 공통 .env에 두면 host에서 pytest를 돌릴 때 minio/clamav 호스트를 찾지 못해
# 테스트가 실패하고 극단적으로 느려진다(docs/tracking/findings.md).

# --- host publish port ---
# host에 열리는 것은 관리 화면 하나뿐이다. PostgreSQL과 MinIO는 internal
# network에만 있어 publish되지 않으며, 관리 접근은 `docker compose exec`로 한다.
# 화면 기본값은 loopback이다. 애플리케이션에 로그인이 없으므로 이 값을 넓히면
# 그 network 전체가 접근 경계가 된다. 원격 접근은 값을 넓히는 대신 loopback을
# 소비하는 tailnet proxy로 붙이는 것을 권장한다.
# publish 자체는 docker-compose.edge.yml overlay를 함께 붙여야 동작한다.
BIDOPS_WEB_BIND_HOST=127.0.0.1
BIDOPS_WEB_PORT=18787

# --- 승인된 배포 참조 ---
# 후보 품질 증적이 통과한 뒤에만 채운다. 비어 있으면 심층 검토 생성이
# fail closed하는 것이 정상이다.
BIDOPS_ACTIVE_PROFILE_VERSION_ID=
BIDOPS_ACTIVE_ANALYSIS_POLICY_VERSION_ID=
