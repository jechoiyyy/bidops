        class _C2:
            def __init__(self, **_kwargs):
                pass
    
            def run_once(self, _session):
                calls["c2"] += 1
                return None
    
        class _Fit:
            def __init__(self, **_kwargs):
                pass
    
            def run_once(self, _session, _worker_id):
                calls["fit"] += 1
                return False
    
        def _never(name):
            def call(*_args, **_kwargs):
                calls[name] += 1
                return SimpleNamespace(claimed=False, identity_error=None)
            return call
    
