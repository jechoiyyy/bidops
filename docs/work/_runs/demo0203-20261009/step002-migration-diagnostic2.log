CREATE TABLE bidops.screening_execution (
	queue_no SERIAL NOT NULL, 
	execution_id VARCHAR(36) NOT NULL, 
	trigger VARCHAR(32) NOT NULL, 
	source_run_id VARCHAR(160) NOT NULL, 
	scope VARCHAR(32) NOT NULL, 
	notice_pk INTEGER, 
	notice_id VARCHAR(255), 
	status VARCHAR(16) NOT NULL, 
	active_slot INTEGER, 
	requested_by VARCHAR(255) NOT NULL, 
	policy_version VARCHAR(255) NOT NULL, 
	prompt_version VARCHAR(255) NOT NULL, 
	model_name VARCHAR(255) NOT NULL, 
	model_digest VARCHAR(64) NOT NULL, 
	company_profile_version VARCHAR(128) NOT NULL, 
	company_profile_digest VARCHAR(64) NOT NULL, 
	generation_config_json JSON DEFAULT '{"num_ctx":16384,"num_predict":{"counterargument":2048,"perspective":2048,"synthesis":4096},"schema_version":"bidops.generation-config.v1","stream":false,"think":false}' NOT NULL, 
	generation_config_digest VARCHAR(64) DEFAULT '51f1878845ed282b20e9c074ca29adbb5ce0a208c89ffae51425a2565ad5dfd1' NOT NULL, 
	input_artifact_path TEXT NOT NULL, 
	input_artifact_digest VARCHAR(64) NOT NULL, 
	artifact_dir TEXT NOT NULL, 
	current_notice_id VARCHAR(255), 
	current_stage VARCHAR(64), 
	stop_requested_at TIMESTAMP WITH TIME ZONE, 
	stop_requested_by VARCHAR(255), 
	stop_reason VARCHAR(32), 
	queued_at TIMESTAMP WITH TIME ZONE NOT NULL, 
	started_at TIMESTAMP WITH TIME ZONE, 
	finished_at TIMESTAMP WITH TIME ZONE, 
	heartbeat_at TIMESTAMP WITH TIME ZONE, 
	candidate_count INTEGER DEFAULT '0' NOT NULL, 
	completed_count INTEGER DEFAULT '0' NOT NULL, 
	failure_count INTEGER DEFAULT '0' NOT NULL, 
	published_run_id VARCHAR(160), 
	error_summary TEXT, 
	PRIMARY KEY (queue_no), 
	CONSTRAINT ck_screening_execution_id CHECK (length(execution_id) = 36 AND substr(execution_id, 1, 4) = 'scr-' AND substr(execution_id, 5) ~ '^[0-9a-f]*$'), 
	CONSTRAINT ck_screening_execution_trigger CHECK (trigger IN ('cli_single', 'manual_run', 'quality_gate', 'schedule')), 
	CONSTRAINT ck_screening_execution_scope CHECK (scope IN ('single_notice', 'full_run', 'quality_sample')), 
	CONSTRAINT ck_screening_execution_status CHECK (status IN ('대기', '실행 중', '중지 요청', '성공', '부분 성공', '실패', '중단됨')), 
	CONSTRAINT ck_screening_execution_single_notice CHECK (((scope = 'single_notice' AND notice_pk IS NOT NULL AND notice_id IS NOT NULL) OR (scope <> 'single_notice' AND notice_pk IS NULL AND notice_id IS NULL))), 
	CONSTRAINT ck_screening_execution_active_slot CHECK (((status IN ('실행 중', '중지 요청') AND active_slot = 1) OR (status NOT IN ('실행 중', '중지 요청') AND active_slot IS NULL))), 
	CONSTRAINT ck_screening_execution_terminal CHECK (((status IN ('성공', '부분 성공', '실패', '중단됨') AND finished_at IS NOT NULL) OR (status NOT IN ('성공', '부분 성공', '실패', '중단됨') AND finished_at IS NULL))), 
	CONSTRAINT ck_screening_execution_stop_reason CHECK (stop_reason IS NULL OR stop_reason IN ('user_requested', 'process_interrupted')), 
	CONSTRAINT ck_screening_execution_counts CHECK (candidate_count >= 0 AND completed_count >= 0 AND failure_count >= 0), 
	CONSTRAINT ck_screening_execution_requested_by CHECK (length(trim(requested_by)) > 0), 
	CONSTRAINT ck_screening_execution_stop_requested_by CHECK (stop_requested_by IS NULL OR length(trim(stop_requested_by)) > 0), 
	CONSTRAINT ck_screening_execution_stop_pair CHECK ((stop_requested_at IS NULL AND stop_requested_by IS NULL) OR (stop_requested_at IS NOT NULL AND stop_requested_by IS NOT NULL)), 
	CONSTRAINT ck_screening_execution_stop_requested CHECK (status <> '중지 요청' OR (stop_requested_at IS NOT NULL AND stop_requested_by IS NOT NULL)), 
	CONSTRAINT ck_screening_execution_user_stop_pair CHECK (stop_reason <> 'user_requested' OR (stop_requested_at IS NOT NULL AND stop_requested_by IS NOT NULL)), 
	CONSTRAINT ck_screening_execution_strings CHECK (length(trim(source_run_id)) > 0 AND length(trim(policy_version)) > 0 AND length(trim(prompt_version)) > 0 AND length(trim(model_name)) > 0 AND length(trim(company_profile_version)) > 0 AND (notice_id IS NULL OR length(trim(notice_id)) > 0) AND (current_notice_id IS NULL OR length(trim(current_notice_id)) > 0) AND (current_stage IS NULL OR length(trim(current_stage)) > 0) AND (stop_requested_by IS NULL OR length(trim(stop_requested_by)) > 0) AND (error_summary IS NULL OR length(trim(error_summary)) > 0)), 
	CONSTRAINT ck_screening_execution_input_artifact_digest CHECK (length(input_artifact_digest) = 64 AND input_artifact_digest ~ '^[0-9a-f]*$'), 
	CONSTRAINT ck_screening_execution_input_artifact_nonempty CHECK (length(trim(input_artifact_path)) > 0), 
	CONSTRAINT ck_screening_execution_artifact_dir_nonempty CHECK (length(trim(artifact_dir)) > 0), 
	CONSTRAINT ck_screening_execution_model_digest CHECK (length(model_digest) = 64 AND model_digest ~ '^[0-9a-f]*$'), 
	CONSTRAINT ck_screening_execution_profile_digest CHECK (length(company_profile_digest) = 64 AND company_profile_digest ~ '^[0-9a-f]*$'), 
	CONSTRAINT ck_screening_execution_input_artifact_path CHECK (length(trim(input_artifact_path)) > 0 AND input_artifact_path NOT LIKE '/%%' AND input_artifact_path !~ '\\' AND input_artifact_path <> '..' AND input_artifact_path NOT LIKE '../%%' AND input_artifact_path NOT LIKE '%%/../%%' AND input_artifact_path NOT LIKE '%%/..'), 
	CONSTRAINT ck_screening_execution_artifact_dir CHECK (length(trim(artifact_dir)) > 0 AND artifact_dir NOT LIKE '/%%' AND artifact_dir !~ '\\' AND artifact_dir <> '..' AND artifact_dir NOT LIKE '../%%' AND artifact_dir NOT LIKE '%%/../%%' AND artifact_dir NOT LIKE '%%/..'), 
	CONSTRAINT ck_screening_execution_generation_config_json CHECK (jsonb_typeof(generation_config_json) = 'object'), 
	CONSTRAINT ck_screening_execution_generation_config_digest CHECK (length(generation_config_digest) = 64 AND generation_config_digest ~ '^[0-9a-f]*$'), 
	UNIQUE (execution_id), 
	UNIQUE (input_artifact_path), 
	UNIQUE (artifact_dir), 
	UNIQUE (published_run_id)
)

