# syntax=docker/dockerfile:1
# Frontend-only release: the running production web image with a new frontend bundle.
# The frontend stage mirrors docker/Dockerfile (npm ci from the committed lockfile).
FROM --platform=$BUILDPLATFORM node:22-alpine AS frontend
WORKDIR /build
COPY web/frontend/package.json web/frontend/package-lock.json ./
RUN npm ci
COPY web/frontend/ ./
RUN npm run build

FROM bidops:list-review-sheets-20261123
USER root
RUN rm -rf /app/web/frontend/dist
COPY --chown=bidops:bidops --from=frontend /build/dist /app/web/frontend/dist
LABEL bidops.release.change="table-workbench layout frontend (ADR-0077), frontend bundle only"
LABEL bidops.release.frontend-commit="1d85c1b" bidops.release.frontend-tree="b744f687b3cb"
USER bidops:bidops
