# docker-compose.model-egress.yml(그리고 C-2를 쓸 때 docker-compose.c2-order-plan.yml)
# 전용 값. 사용법:
#   docker compose --env-file .env --env-file env/model.env \
#     -f docker-compose.yml -f docker-compose.edge.yml \
#     -f docker-compose.model-egress.yml \
#     up -d web document-worker analysis-worker
#
# overlay는 network만 연다. 승인된 IP/port 외 egress는 host 방화벽에서 막는다.
# 쓰지 않는 용도는 비워 둔다 — 그 용도의 호출은 네트워크 접촉 전에 fail closed한다.
#
# 주소는 컨테이너 안에서 도달 가능해야 한다. host의 모델 서버를 쓸 때 127.0.0.1은
# 컨테이너 자기 자신을 가리키므로 쓸 수 없다. 경로는 OpenAI 호환 `/v1`이어야 한다.
# URL에 자격증명을 넣지 않는다. 허용 host는 endpoint와 같은 literal host여야 한다.
# 192.0.2.10은 TEST-NET 자리표시자이며 실제 모델 서버가 아니다.

# --- C-1 공고 판정(screening) ---
BIDOPS_VLLM_SCREENING_BASE_URL=
BIDOPS_VLLM_SCREENING_ALLOWED_HOSTS=
BIDOPS_VLLM_SCREENING_API_KEY=EMPTY
# 배포가 증언하는 64자 model revision(ADR-0042). MVP 기간에는 비워도 호출이
# 나가지만(ADR-0050 완화), 값을 주면 64자 hex 검사를 통과해야 한다.
BIDOPS_VLLM_SCREENING_MODEL_REVISION=
# 서버가 실제로 서빙하는 모델 id. `GET /models`의 id와 같아야 한다.
BIDOPS_VLLM_SCREENING_MODEL=qwen3.8-27B

# --- 사전규격 개요·회사 핏(overview) ---
BIDOPS_VLLM_OVERVIEW_BASE_URL=
BIDOPS_VLLM_OVERVIEW_ALLOWED_HOSTS=
BIDOPS_VLLM_OVERVIEW_API_KEY=EMPTY
BIDOPS_VLLM_OVERVIEW_MODEL_REVISION=

# --- 심층 검토(deep_review) ---
BIDOPS_VLLM_DEEP_REVIEW_BASE_URL=
BIDOPS_VLLM_DEEP_REVIEW_ALLOWED_HOSTS=
BIDOPS_VLLM_DEEP_REVIEW_API_KEY=EMPTY
BIDOPS_VLLM_DEEP_REVIEW_MODEL_REVISION=

# --- 용도별 값이 비었을 때 쓰는 공유값(C-2 발주계획 어댑터가 읽는 값이기도 하다) ---
BIDOPS_VLLM_BASE_URL=http://192.0.2.10:8000/v1
BIDOPS_VLLM_ALLOWED_HOSTS=192.0.2.10
BIDOPS_VLLM_API_KEY=EMPTY
# 서버 운영자가 확인해 준 64자 model artifact digest. binding의
# stage2_binding.model_digest와 같아야 하며, 다르면 C-2가 실행 전에 fail closed한다.
# OpenAI 호환 vLLM은 weight revision을 응답에도 /v1/models에도 싣지 않으므로 이 값이
# 배포의 선언이다(ADR-0042). 모델 weight가 바뀔 때만 갱신한다.
BIDOPS_VLLM_MODEL_REVISION=

# --- C-2 발주계획 판정 입력(docker-compose.c2-order-plan.yml 전용) ---
# 배포별 transport 승인과 활성 binding이 기록되기 전까지 false로 둔다.
BIDOPS_C2_EXECUTION_ALLOWED=false
# c2-order-plan overlay를 쓰려면 반드시 채운다. 운영자가 승인한 host 경로여야 하며
# 저장소는 회사 입력 자료를 제공하지 않는다.
# BIDOPS_C2_CAPABILITIES_HOST_PATH=/secure/path/company-capabilities.json
# BIDOPS_C2_PROMPT_HOST_PATH=/secure/path/order-plan-prompt.txt
