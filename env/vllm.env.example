# docker-compose.t7.remote-vllm.yml 전용 값.
# 사용법:
#   docker compose --env-file .env --env-file env/vllm.env \
#     -f docker-compose.t7.yml -f docker-compose.t7.remote-vllm.yml \
#     up -d web document-worker analysis-worker
#
# URL에 자격증명을 넣지 않는다. allowlist는 endpoint와 같은 literal IP여야 한다.
# 192.0.2.10은 TEST-NET 자리표시자이며 실제 모델 서버가 아니다.
BIDOPS_VLLM_BASE_URL=http://192.0.2.10:8000/v1
BIDOPS_VLLM_ALLOWED_HOSTS=192.0.2.10
BIDOPS_VLLM_API_KEY=EMPTY
# Keep C-2 execution disabled until a separate per-deployment transport
# approval and an active binding are recorded.
BIDOPS_C2_EXECUTION_ALLOWED=false
# Required to use the remote overlay. These must be explicit host paths to
# operator-approved files; the repository does not provide company inputs.
# BIDOPS_C2_CAPABILITIES_HOST_PATH=/secure/path/company-capabilities.json
# BIDOPS_C2_PROMPT_HOST_PATH=/secure/path/order-plan-prompt.txt
