# docker-compose.slack-egress.yml 전용 값(RL-01 평일 브리핑 Slack).
#
# 이 파일을 복사한 뒤 값을 채운다. env/slack.env는 gitignore이며 토큰은 여기에만 둔다.
#
#   cp env/slack.env.example env/slack.env
#
# BIDOPS_SLACK_ENABLED가 false이거나 토큰·채널이 비어 있으면 전송·연결하지 않는다
# (fail closed). 허용 host는 정확히 일치해야 하며 비우면 어떤 host도 허용하지 않는다.
BIDOPS_SLACK_ENABLED=false
# chat.postMessage·chat.update용 bot token(xoxb-)
BIDOPS_SLACK_BOT_TOKEN=
# Socket Mode용 app-level token(xapp-, connections:write)
BIDOPS_SLACK_APP_TOKEN=
# 브리핑 전용 채널 하나의 ID
BIDOPS_SLACK_CHANNEL_ID=
BIDOPS_SLACK_ALLOWED_HOSTS=slack.com,wss-primary.slack.com
# 메시지 레코드 링크의 기준 주소(예: 사내망 관리 화면 주소)
BIDOPS_PUBLIC_BASE_URL=
