# docker-compose.screening.yml 전용 값.
# 사용법:
#   docker compose --env-file .env --env-file env/screening.env \
#     -f docker-compose.yml -f docker-compose.screening.yml up -d web
#
# 이 파일을 넘기지 않거나 endpoint가 비어 있으면 overlay가 fail closed한다.
# overlay는 network만 연다. 승인된 IP/port 외 egress는 host 방화벽에서 막는다.
# 컨테이너 안에서 도달 가능한 주소여야 한다. host의 Ollama를 쓸 때 127.0.0.1은
# 컨테이너 자기 자신을 가리키므로 사용할 수 없다.
BIDOPS_OLLAMA_BASE_URL=
BIDOPS_OLLAMA_MODEL=qwen3.8:27b
