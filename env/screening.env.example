# docker-compose.screening.yml 전용 값.
# 사용법:
#   docker compose --env-file .env --env-file env/screening.env \
#     -f docker-compose.yml -f docker-compose.screening.yml up -d web
#
# 이 파일을 넘기지 않거나 endpoint·허용 host·선언 revision이 비어 있으면
# overlay가 fail closed한다. overlay는 network만 연다. 승인된 IP/port 외
# egress는 host 방화벽에서 막는다.
#
# 컨테이너 안에서 도달 가능한 주소여야 한다. host의 모델 서버를 쓸 때
# 127.0.0.1은 컨테이너 자기 자신을 가리키므로 사용할 수 없다.
# 경로는 OpenAI 호환 `/v1`이어야 한다.
BIDOPS_VLLM_SCREENING_BASE_URL=
# base URL의 host와 같은 리터럴 IP를 적는다. 비면 C-1이 fail closed한다.
BIDOPS_VLLM_SCREENING_ALLOWED_HOSTS=
BIDOPS_VLLM_SCREENING_API_KEY=EMPTY
# 배포가 증언하는 64자 model revision(ADR-0042). 비면 fail closed한다.
BIDOPS_VLLM_SCREENING_MODEL_REVISION=
# 서버가 실제로 서빙하는 모델 id. `GET /models`의 id와 같아야 한다.
BIDOPS_VLLM_SCREENING_MODEL=qwen3.8-27B
