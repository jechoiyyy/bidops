# docker/docker-compose.prod.yml 전용 값.
# Selected with BIDOPS_ENV=prod scripts/compose.sh; do not assemble overlays manually.

#
# 이 파일을 복사한 뒤 실제 host firewall 정책과 같은 승인 host만 적는다.
# overlay가 없으면 BIDOPS_G2B_ATTACHMENT_ENABLED는 false로 유지된다.
#
#   cp env/prespec-attachment.env.example env/prespec-attachment.env
#   BIDOPS_ENV=prod scripts/compose.sh up -d --no-deps prespec-attachment-worker
#
# URL이나 자격증명을 이 파일에 넣지 않는다.
BIDOPS_G2B_ATTACHMENT_ALLOWED_HOSTS=www.g2b.go.kr
