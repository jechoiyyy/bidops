# docker-compose.t7.codex-reference.yml 전용 값. 개발 검증 한정이며
# 운영 배포와 Qwen 품질 승인 증적으로 사용할 수 없다.
# docs/operations.md의 배포 차단 조건과 docs/tracking/findings.md를 먼저 읽는다.
#
# 사용법:
#   docker compose --env-file .env --env-file env/codex.env \
#     -f docker-compose.t7.yml -f docker-compose.t7.codex-reference.yml up -d
#
# 외부 전송 경로이므로 대상 내부 notice_id마다 담당자 승인이 선행되어야 한다.
BIDOPS_CODEX_EXEC_MODEL=gpt-5.6-sol
BIDOPS_CODEX_EXEC_REASONING_EFFORT=low
# 승인된 내부 numeric notice ID를 쉼표로 구분해 적는다. 비어 있으면 403으로 막힌다.
BIDOPS_CODEX_EXEC_APPROVED_NOTICE_IDS=
# host 절대 경로. 두 파일 모두 read-only로 bind된다.
BIDOPS_CODEX_EXEC_HOST_BIN=
BIDOPS_CODEX_EXEC_HOST_AUTH_FILE=
