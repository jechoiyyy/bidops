            }
          },
          "required": ["claim", "locator"],
          "type": "object"
        },
        "minItems": 1,
        "type": "array"
      },
      "input_limitations": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
