{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bidops.deep-review-validation.v1",
  "title": "BidOps deep review validation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "validation_run_id", "report_revision_id", "status", "checks", "created_at"],
  "properties": {
    "schema": {"const": "bidops.deep-review-validation.v1"},
    "validation_run_id": {"$ref": "#/$defs/uuid"},
    "report_revision_id": {"$ref": "#/$defs/uuid"},
    "status": {"enum": ["passed", "failed"]},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "risk": {"enum": ["차단", "중대", "보통", "낮음"]},
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_type", "status", "severity", "message", "related_claim_ids", "related_evidence_ids"],
      "properties": {"check_type": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed", "warning"]}, "severity": {"$ref": "#/$defs/risk"}, "message": {"type": "string", "minLength": 1}, "related_claim_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}}, "related_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}}
      }
    }
  }
}
