{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bidops.document-segments.v1",
  "title": "BidOps document segments v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "structure_id", "document_version_id", "source_sha256", "taxonomy_version", "extractor_binding", "extractor_binding_sha256", "payload_sha256", "segments", "inventory_summary", "coverage", "warnings", "created_at"],
  "properties": {
    "schema": {"const": "bidops.document-segments.v1"},
    "structure_id": {"$ref": "#/$defs/uuid"},
    "document_version_id": {"$ref": "#/$defs/uuid"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "extractor_binding": {"$ref": "#/$defs/binding"},
    "extractor_binding_sha256": {"$ref": "#/$defs/sha256"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "inventory_summary": {"$ref": "#/$defs/inventory_summary"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "taxonomy_label": {"enum": ["business_eligibility_evaluation", "technical_functional", "quality_security_constraints", "partnership_governance"]},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "taxonomy_version", "rules_sha256", "schema"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "taxonomy_version": {"type": "string", "minLength": 1}, "rules_sha256": {"$ref": "#/$defs/sha256"}, "schema": {"const": "bidops.document-segments.v1"}}
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "block_key", "page", "ordinal", "table_key", "row", "column"],
      "properties": {"kind": {"enum": ["paragraph", "table_cell", "block"]}, "block_key": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}, "ordinal": {"type": "integer", "minimum": 0}, "table_key": {"type": ["string", "null"]}, "row": {"type": ["integer", "null"], "minimum": 0}, "column": {"type": ["integer", "null"], "minimum": 0}}
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "ordinal", "taxonomy_labels", "start_locator", "end_locator", "requirement_ids", "source_block_keys", "classification_source", "confidence", "status", "page_range", "mapping_status"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 1},
        "taxonomy_labels": {"type": "array", "items": {"$ref": "#/$defs/taxonomy_label"}, "uniqueItems": true},
        "start_locator": {"$ref": "#/$defs/locator"},
        "end_locator": {"$ref": "#/$defs/locator"},
        "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_block_keys": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "classification_source": {"const": "deterministic"},
        "confidence": {"type": "null"},
        "status": {"enum": ["classified", "needs_human_review"]},
        "page_range": {"oneOf": [{"$ref": "#/$defs/page_range"}, {"type": "null"}]},
        "mapping_status": {"enum": ["mapped", "partial", "unavailable"]}
      }
    },
    "page_range": {
      "type": "object", "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {"first": {"type": "integer", "minimum": 1}, "last": {"type": "integer", "minimum": 1}}
    },
    "ambiguous_item": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "raw_id", "raw_prefix", "normalized_prefix", "occurrence_count", "locator"],
      "properties": {"reason": {"enum": ["prefix_unconfirmed", "prefix_collision"]}, "raw_id": {"type": ["string", "null"]}, "raw_prefix": {"type": ["string", "null"]}, "normalized_prefix": {"type": "string", "minLength": 1}, "occurrence_count": {"type": "integer", "minimum": 1}, "locator": {"oneOf": [{"$ref": "#/$defs/locator"}, {"type": "null"}]}}
    },
    "inventory_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_ids", "duplicate_ids", "ambiguous_items", "prefixes", "item_count"],
      "properties": {"expected_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "duplicate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "ambiguous_items": {"type": "array", "items": {"$ref": "#/$defs/ambiguous_item"}}, "prefixes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "item_count": {"type": "integer", "minimum": 0}}
    },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["start_ordinal", "end_ordinal"],
      "properties": {"start_ordinal": {"type": "integer", "minimum": 0}, "end_ordinal": {"type": "integer", "minimum": 0}}
    },
    "toc": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_count", "matched_heading_count", "unmatched_entry_count"],
      "properties": {"entry_count": {"type": "integer", "minimum": 0}, "matched_heading_count": {"type": "integer", "minimum": 0}, "unmatched_entry_count": {"type": "integer", "minimum": 0}}
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["block_count", "covered_block_count", "segment_count", "gap_count", "overlap_count", "gaps", "overlaps", "needs_human_review_count", "toc"],
      "properties": {"block_count": {"type": "integer", "minimum": 0}, "covered_block_count": {"type": "integer", "minimum": 0}, "segment_count": {"type": "integer", "minimum": 0}, "gap_count": {"type": "integer", "minimum": 0}, "overlap_count": {"type": "integer", "minimum": 0}, "gaps": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "overlaps": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "needs_human_review_count": {"type": "integer", "minimum": 0}, "toc": {"$ref": "#/$defs/toc"}}
    }
  }
}
