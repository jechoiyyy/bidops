{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bidops.card-analysis-input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "company_binding", "units", "batches", "missing_sections", "selector"],
  "properties": {
    "schema_version": {"const": "bidops.card-analysis-input.v1"},
    "company_binding": {"$ref": "#/$defs/company_binding"},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "batches": {"type": "array", "items": {"$ref": "#/$defs/batch"}},
    "missing_sections": {
      "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/section_kind"}
    },
    "selector": {"$ref": "#/$defs/selector"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "nonempty": {"type": "string", "minLength": 1},
    "company_binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "graph_version_id", "graph_sha256", "profile_version_id", "profile_sha256",
        "ontology_version", "ontology_sha256"
      ],
      "properties": {
        "graph_version_id": {"$ref": "#/$defs/uuid"},
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "profile_version_id": {"$ref": "#/$defs/uuid"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "ontology_version": {"$ref": "#/$defs/nonempty"},
        "ontology_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "section_kind": {
      "type": "string",
      "enum": ["overview", "schedule", "budget", "eligibility", "evaluation", "contract"]
    },
    "page_range": {
      "type": "object", "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": {"type": "integer", "minimum": 1},
        "last": {"type": "integer", "minimum": 1}
      }
    },
    "unit_block": {
      "type": "object", "additionalProperties": false,
      "required": ["block_key", "text"],
      "properties": {
        "block_key": {"$ref": "#/$defs/nonempty"},
        "text": {"type": "string"}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": [
        "unit_id", "source_sha256", "document_version_id", "structure_id", "manifest_id",
        "kind", "ordinal", "normalized_id", "section_kinds", "blocks", "page_range", "mapping_status"
      ],
      "properties": {
        "unit_id": {"$ref": "#/$defs/nonempty"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "document_version_id": {"$ref": "#/$defs/uuid"},
        "structure_id": {"$ref": "#/$defs/uuid"},
        "manifest_id": {"$ref": "#/$defs/uuid"},
        "kind": {"type": "string", "enum": ["card", "segment"]},
        "ordinal": {"type": "integer", "minimum": 0},
        "normalized_id": {"type": ["string", "null"], "minLength": 1},
        "section_kinds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/section_kind"}},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit_block"}},
        "page_range": {"anyOf": [{"$ref": "#/$defs/page_range"}, {"type": "null"}]},
        "mapping_status": {"type": "string", "enum": ["mapped", "partial", "inherited", "unavailable"]}
      }
    },
    "batch": {
      "type": "object", "additionalProperties": false,
      "required": ["batch_index", "unit_ids", "source_characters"],
      "properties": {
        "batch_index": {"type": "integer", "minimum": 0},
        "unit_ids": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "source_characters": {"type": "integer", "minimum": 0, "maximum": 12000}
      }
    },
    "candidate_block": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha256", "block_key"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "block_key": {"$ref": "#/$defs/nonempty"}
      }
    },
    "selected_block": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha256", "block_key", "section_kinds"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "block_key": {"$ref": "#/$defs/nonempty"},
        "section_kinds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/section_kind"}
        }
      }
    },
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "sha256", "candidate_blocks", "selected_blocks"],
      "properties": {
        "version": {"enum": ["card-sections-v1", "card-sections-v2", "card-sections-v3"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "candidate_blocks": {"type": "array", "items": {"$ref": "#/$defs/candidate_block"}},
        "selected_blocks": {"type": "array", "items": {"$ref": "#/$defs/selected_block"}}
      }
    }
  }
}
