{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bidops.practitioner-verdict.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict", "reason", "cautions", "next_actions"],
  "properties": {
    "schema_version": {"const": "bidops.practitioner-verdict.v3"},
    "verdict": {"type": "string", "enum": ["진행 가능", "조건부 진행", "진행 어려움", "판단 불가"]},
    "reason": {"$ref": "#/$defs/nonempty"},
    "cautions": {"type": "array", "items": {"$ref": "#/$defs/caution"}},
    "next_actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "unit_ref": {"type": "string", "pattern": "^U[1-9][0-9]*$"},
    "evidence_id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
    "caution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_ref", "text", "evidence_ids"],
      "properties": {
        "unit_ref": {"$ref": "#/$defs/unit_ref"},
        "text": {"$ref": "#/$defs/nonempty"},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_ref", "owner", "action", "evidence_ids"],
      "properties": {
        "unit_ref": {"$ref": "#/$defs/unit_ref"},
        "owner": {"type": ["string", "null"], "minLength": 1},
        "action": {"$ref": "#/$defs/nonempty"},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}}
      }
    }
  }
}
