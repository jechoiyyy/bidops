{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bidops.document-structure.v1",
  "title": "BidOps document structure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "structure_id", "document_version_id", "source_sha256", "media_type", "extractor", "pages", "blocks", "warnings", "created_at"],
  "properties": {
    "schema": {"const": "bidops.document-structure.v1"},
    "structure_id": {"$ref": "#/$defs/uuid"},
    "document_version_id": {"$ref": "#/$defs/uuid"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "media_type": {"type": "string", "minLength": 1},
    "extractor": {"$ref": "#/$defs/extractor"},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}},
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "finite_number": {"type": "number"},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/finite_number"}},
    "extractor": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "upstream_commit"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "upstream_commit": {"type": ["string", "null"]}}
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "width", "height", "image_content_object_id"],
      "properties": {"number": {"type": "integer", "minimum": 1}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "image_content_object_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}}
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["block_key", "parent_block_key", "type", "page", "bbox", "text", "confidence", "attributes"],
      "properties": {
        "block_key": {"type": "string", "minLength": 1},
        "parent_block_key": {"type": ["string", "null"], "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/finite_number"}},
        "text": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "attributes": {"type": "object"}
      }
    }
  }
}
