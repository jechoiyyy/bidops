{
  "name": "bidops-admin-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "BIDOPS_MOCK_API=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:contrast": "node --test scripts/check-contrast.test.mjs",
    "test:design": "playwright test --project=layout-laptop --project=layout-desktop design-shell.spec.ts",
    "test:screens": "playwright test --project=app --project=layout-laptop --project=layout-desktop",
    "test:pixel": "playwright test --project=pixel",
    "test:pixel:update": "playwright test --project=pixel --update-snapshots"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.2",
    "@tanstack/react-query": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.39.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.5.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.7.2",
    "vite": "^6.3.5"
  }
}
